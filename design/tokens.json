{
  "$description": "Source unique du design. Ne pas modifier les fichiers générés : éditer ce fichier puis lancer `node design/build.mjs`.",
  "brand": {
    "name": "Temps Mort",
    "publisher": "Hasteria SASU"
  },
  "color": {
    "navy":        { "value": "#14213D", "role": "Fond d'en-tête, texte fort, boutons principaux" },
    "deep":        { "value": "#0B1528", "role": "Pied de page, cadre de la tablette" },
    "navy-soft":   { "value": "#24345A", "role": "Fond secondaire sur navy (sélecteur, pastilles)" },
    "accent":      { "value": "#1E5BD6", "role": "Liens, surtitres, actions positives" },
    "yellow":      { "value": "#FFD23F", "role": "Appel à l'action, joueuse au service, bandeau formats" },
    "ground":      { "value": "#F6F7F9", "role": "Fond du site et du blog" },
    "ground-app":  { "value": "#EDF0F4", "role": "Fond des écrans de l'application" },
    "surface":     { "value": "#FFFFFF", "role": "Cartes" },
    "surface-alt": { "value": "#E6EBF2", "role": "Boutons neutres, emplacements d'image" },
    "line":        { "value": "#D3DAE3", "role": "Bordures" },
    "line-soft":   { "value": "#E3E8EF", "role": "Séparateurs de tableau" },
    "text":        { "value": "#182235", "role": "Texte courant" },
    "muted":       { "value": "#5B6577", "role": "Texte secondaire sur clair" },
    "body-muted":  { "value": "#4A5568", "role": "Paragraphes de carte" },
    "on-navy":     { "value": "#D6E2F5", "role": "Texte courant sur navy" },
    "on-navy-muted": { "value": "#B8C4D9", "role": "Texte secondaire sur navy" },
    "error":       { "value": "#C2541C", "role": "Faute, action destructive" },
    "court":       { "value": "#EFA35C", "role": "Terrain" },
    "court-out":   { "value": "#2E5A95", "role": "Zone libre autour du terrain" },
    "zone-alert":  { "value": "#D9362B", "role": "Zone dessinée au tableau tactique" }
  },
  "font": {
    "display": { "family": "Barlow Condensed", "weights": [600, 700], "fallback": "Arial Narrow, sans-serif" },
    "body":    { "family": "Barlow", "weights": [400, 500, 600, 700], "fallback": "system-ui, sans-serif" }
  },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 18, "pill": 999 },
  "space":  { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 40, "3xl": 72 },
  "layout": { "container": 1200, "container-narrow": 880, "gutter": 24 },
  "touch":  { "min-target": 48, "primary-target": 56 }
}
