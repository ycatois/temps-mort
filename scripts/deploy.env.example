# Copier en scripts/deploy.env (non commité). Accès SSH o2switch : cPanel > « Accès SSH » / autoriser votre IP
# dans l'outil de whitelist SSH d'o2switch avant la première connexion.
O2_HOST=xxx.o2switch.net
O2_USER=moncompte
O2_PORT=22
# Dossiers distants
O2_PUBLIC=public_html
O2_APP=tempsmort-app
O2_BLOG=public_html/blog
