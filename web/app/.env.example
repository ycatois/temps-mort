# Copier en app/.env (jamais commité). Sur o2switch : ~/tempsmort-app/.env
APP_BRAND="Temps Mort"
APP_DEBUG=false
APP_URL=https://www.exemple.fr
APP_BASE_PATH=
BLOG_URL=/blog/
CONTACT_EMAIL=contact@exemple.fr

# MariaDB o2switch : base et utilisateur créés dans cPanel > Bases de données MySQL
# (les noms sont préfixés par l'identifiant cPanel, ex. moncompte_tempsmort)
DB_DSN="mysql:host=localhost;dbname=moncompte_tempsmort;charset=utf8mb4"
DB_USER=moncompte_tempsmort
DB_PASSWORD=

# API de l'app : secret aléatoire d'au moins 32 caractères (php -r "echo bin2hex(random_bytes(32));")
APP_SECRET=
# Expéditeur des e-mails (mot de passe oublié). En production, une adresse du domaine.
MAIL_FROM="Temps Mort <ne-pas-repondre@exemple.fr>"
# En local seulement : Mailpit (docker compose). Laisser vide en production.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=1025
